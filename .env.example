# ---------------------------------------------------------------------------
# AkaziNet environment configuration
#
# Copy this file to `.env` and fill in the values for your host:
#
#   cp .env.example .env
#
# PREFERRED: put `.env` in the directory ABOVE the project root (one level above
# this folder). config/env.php checks there first, and a file outside the docroot
# cannot be downloaded even if .htaccess protection is ever lost.
#
# .env is gitignored. Never commit real credentials.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Same value the app connects with. Do not hardcode it in any .sql file: run
# migrations with `mysql -u DB_USER -p DB_NAME < database/migrationN.sql`.
DB_HOST=localhost
DB_NAME=yahfyszyyb_akazinet
DB_USER=yahfyszyyb_akazinet
DB_PASS=change-me
DB_CHARSET=utf8mb4

# --- Site ------------------------------------------------------------------
# Must match the real public origin, with no trailing slash. Used for canonical
# URLs, Open Graph tags, and schema.org JSON-LD, so a wrong value here causes
# SEO problems rather than a visible error.
SITE_URL=https://akazinet.com
SITE_NAME=AkaziNet

# --- Office location -------------------------------------------------------
# Published on the contact page (card, map and directions link), in the footer,
# in the privacy policy and in schema.org JSON-LD. Change all of these together;
# SITE_ADDRESS is built from the first two. The coordinates are the centre of the
# town, which is the most specific point we can evidence without a street address.
SITE_CITY=Kayonza
SITE_PROVINCE=Eastern Province
SITE_LAT=-1.8847
SITE_LNG=30.5168

# --- Session ---------------------------------------------------------------
# Leave as-is unless you have a reason to change it. Changing it logs everyone
# out.
SESSION_NAME=AKAZINETSESSID

# --- Security --------------------------------------------------------------
# NEVER enable this in production. It prints raw error messages and stack
# traces to the browser.
APP_DEBUG=0

# Login throttling: N failures inside the window locks out BOTH that account
# and that IP. Requires database/migration18.sql.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Comma-separated IPs of proxies you control. Only then is X-Forwarded-For
# trusted for rate limiting. Leave empty if AkaziNet is served directly.
# TRUSTED_PROXIES=

# --- Uploads ---------------------------------------------------------------
# Bytes. Default 10MB.
MAX_UPLOAD_SIZE=10485760