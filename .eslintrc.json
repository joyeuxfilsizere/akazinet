{
  "root": true,
  "env": {
    "browser": true,
    "es2021": true
  },
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "script"
  },
  "extends": "eslint:recommended",
  "rules": {
    "no-unused-vars": ["error", { "args": "none" }],
    "no-undef": "error",
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "eqeqeq": ["error", "smart"],
    "no-eval": "error",
    "no-implied-eval": "error"
  },
  "globals": {
    "adsbygoogle": "readonly",
    "dataLayer": "writable",
    "Quill": "readonly",
    "L": "readonly"
  }
}